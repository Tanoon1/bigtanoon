{
  "name": "big-brother-3d",
  "version": "1.0.0",
  "description": "האח הגדול – משחק מולטיפלייר תלת-ממדי בדפדפן",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node test/logic.test.js && node test/sim.js",
    "test:sim": "node test/sim.js",
    "test:e2e": "npm run build && node test/e2e.js",
    "test:e2e:full": "npm run build && node test/e2e-full.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "livekit-server-sdk": "^2.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "livekit-client": "^2.9.0",
    "three": "0.170.0",
    "vite": "^5.4.11"
  }
}