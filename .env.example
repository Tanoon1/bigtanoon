# --- game server ---
PORT=3000
# BB_MIN_PLAYERS=3          # minimum players to start (set 1 for solo testing)
# BB_TIME_SCALE=1           # <1 speeds all phases up (testing)

# --- Voice: LiveKit SFU (recommended for 6-16 players) ---
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Voice fallback: P2P mesh (used when LiveKit is not configured) ---
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_SECRET=shared-secret-from-coturn      # coturn "use-auth-secret" (time-limited creds)
# TURN_USERNAME=...                          # or static credentials
# TURN_CREDENTIAL=...
